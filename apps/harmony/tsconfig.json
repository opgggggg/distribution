{
	"compilerOptions": {
		"paths": {
			"@yaochn/als-office-editor-ui/document-preview": [
				"../../als-office/packages/editor-ui/src/document-preview.ts"
			]
		},
		"target": "ES2022",
		"useDefineForClassFields": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"isolatedModules": true,
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"skipLibCheck": true,
		"types": ["vite/client"]
	},
	"include": ["web/src/**/*.ts", "web/src/**/*.vue", "vite.config.ts"]
}
