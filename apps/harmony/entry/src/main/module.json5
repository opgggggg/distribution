{
	module: {
		name: "entry",
		type: "entry",
		description: "$string:module_desc",
		mainElement: "EntryAbility",
		deviceTypes: ["phone", "tablet", "2in1"],
		deliveryWithInstall: true,
		installationFree: false,
		// GET_NETWORK_INFO is what makes navigator.onLine truthful inside ArkWeb; without
		// it the Web component reports itself offline whether or not there is a network.
		requestPermissions: [
			{ name: "ohos.permission.INTERNET" },
			{ name: "ohos.permission.GET_NETWORK_INFO" },
		],
		pages: "$profile:main_pages",
		abilities: [
			{
				name: "EntryAbility",
				srcEntry: "./ets/entryability/EntryAbility.ets",
				description: "$string:EntryAbility_desc",
				icon: "$media:app_icon",
				label: "$string:EntryAbility_label",
				startWindowIcon: "$media:app_icon",
				startWindowBackground: "$color:start_window_background",
				exported: true,
				skills: [
					{
						entities: ["entity.system.home"],
						actions: ["action.system.home"],
					},
					{
						actions: [
							"ohos.want.action.viewData",
							"ohos.want.action.sendData",
							"ohos.want.action.sendMultipleData",
						],
						uris: [
							{
								scheme: "file",
								type: "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
								linkFeature: "FileOpen",
							},
							{
								scheme: "file",
								type: "application/vnd.openxmlformats-officedocument.presentationml.presentation",
								linkFeature: "FileOpen",
							},
							{
								scheme: "file",
								type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
								linkFeature: "FileOpen",
							},
							{ scheme: "file", type: "application/msword", linkFeature: "FileOpen" },
							{
								scheme: "file",
								type: "application/vnd.ms-excel",
								linkFeature: "FileOpen",
							},
							{
								scheme: "file",
								type: "application/vnd.ms-powerpoint",
								linkFeature: "FileOpen",
							},
							{
								scheme: "file",
								type: "application/vnd.ms-visio.drawing",
								linkFeature: "FileOpen",
							},
							{
								scheme: "file",
								type: "application/vnd.ms-visio.drawing.main+xml",
								linkFeature: "FileOpen",
							},
							{
								scheme: "file",
								type: "application/vnd.sas.jmp",
								linkFeature: "FileOpen",
							},
							{ scheme: "file", type: "application/x-jmp", linkFeature: "FileOpen" },
							{
								scheme: "file",
								type: "application/x-jmp-data-table",
								linkFeature: "FileOpen",
							},
							{
								scheme: "file",
								type: "application/vnd.jgraph.mxfile",
								linkFeature: "FileOpen",
							},
							{
								scheme: "file",
								type: "application/x-drawio",
								linkFeature: "FileOpen",
							},
							{ scheme: "file", type: "application/xml", linkFeature: "FileOpen" },
							{ scheme: "file", type: "text/xml", linkFeature: "FileOpen" },
							{ scheme: "file", type: "application/pdf", linkFeature: "FileOpen" },
							{ scheme: "file", type: "image/png", linkFeature: "FileOpen" },
							{ scheme: "file", type: "image/jpeg", linkFeature: "FileOpen" },
							{ scheme: "file", type: "image/webp", linkFeature: "FileOpen" },
							{ scheme: "file", type: "image/emf", linkFeature: "FileOpen" },
							{ scheme: "file", type: "application/emf", linkFeature: "FileOpen" },
							{ scheme: "file", type: "application/x-emf", linkFeature: "FileOpen" },
							{ scheme: "file", type: "image/wmf", linkFeature: "FileOpen" },
							{ scheme: "file", type: "application/wmf", linkFeature: "FileOpen" },
							{ scheme: "file", type: "application/x-wmf", linkFeature: "FileOpen" },
							{
								scheme: "file",
								type: "application/x-msmetafile",
								linkFeature: "FileOpen",
							},
							{ scheme: "file", type: "text/csv", linkFeature: "FileOpen" },
							{ scheme: "file", type: "application/ofd", linkFeature: "FileOpen" },
							{ scheme: "file", type: "text/x-java-source", linkFeature: "FileOpen" },
							{ scheme: "file", type: "text/javascript", linkFeature: "FileOpen" },
							{
								scheme: "file",
								type: "application/javascript",
								linkFeature: "FileOpen",
							},
							{ scheme: "file", type: "application/json", linkFeature: "FileOpen" },
							{ scheme: "file", type: "text/html", linkFeature: "FileOpen" },
							{ scheme: "file", type: "text/css", linkFeature: "FileOpen" },
							{ scheme: "file", type: "text/x-python", linkFeature: "FileOpen" },
							{ scheme: "file", type: "text/x-shellscript", linkFeature: "FileOpen" },
							{ scheme: "file", type: "application/yaml", linkFeature: "FileOpen" },
							{ scheme: "file", type: "text/yaml", linkFeature: "FileOpen" },
							{ scheme: "file", type: "text/markdown", linkFeature: "FileOpen" },
							{ scheme: "file", type: "text/x-markdown", linkFeature: "FileOpen" },
							{
								scheme: "file",
								type: "application/x-markdown",
								linkFeature: "FileOpen",
							},
							{ scheme: "file", type: "text/plain", linkFeature: "FileOpen" },
							{
								scheme: "file",
								type: "application/octet-stream",
								linkFeature: "FileOpen",
							},
						],
					},
				],
			},
		],
	},
}
