/** The single save-picker choice that keeps a document's own extension. */
export function saveSuffixChoice(fileName: string): string {
  const dot = fileName.lastIndexOf('.');
  const extension = dot < 0 ? '' : fileName.substring(dot + 1).toLocaleLowerCase();
  const label = SAVE_LABELS.get(extension);
  return label === undefined ? 'Word document|.docx' : `${label}|.${extension}`;
}
