{
	app: {
		signingConfigs: [],
		products: [
			{
				name: "default",
				signingConfig: "default",
				// app-profile:start
				bundleName: "com.cubexp.office",
				vendor: "cubexp",
				versionCode: 1003002,
				versionName: "1.3.1",
				icon: "$media:app_icon",
				label: "$string:app_name",
				// app-profile:end
				targetSdkVersion: "5.1.0(18)",
				compatibleSdkVersion: "5.0.5(17)",
				runtimeOS: "HarmonyOS",
				buildOption: {
					strictMode: {
						caseSensitiveCheck: true,
						useNormalizedOHMUrl: true,
					},
				},
			},
		],
		buildModeSet: [
			{
				name: "debug",
			},
			{
				name: "release",
			},
		],
	},
	modules: [
		{
			name: "entry",
			srcPath: "./entry",
			targets: [
				{
					name: "default",
					applyToProducts: ["default"],
				},
			],
		},
	],
}
