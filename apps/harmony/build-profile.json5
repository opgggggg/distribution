{
	app: {
		signingConfigs: [],
		products: [
			{
				name: "default",
				signingConfig: "default",
				// app-profile:start
				bundleName: "com.cubexp.office",
				vendor: "cubexp",
				versionCode: 1004002,
				versionName: "1.4.2",
				icon: "$media:app_icon",
				label: "$string:app_name",
				// app-profile:end
				targetSdkVersion: "6.1.1(24)",
				compatibleSdkVersion: "6.1.1(24)",
				runtimeOS: "HarmonyOS",
				buildOption: {
					strictMode: {
						caseSensitiveCheck: true,
						useNormalizedOHMUrl: true,
					},
				},
			},
		],
		buildModeSet: [
			{
				name: "debug",
			},
			{
				name: "release",
			},
		],
	},
	modules: [
		{
			name: "entry",
			srcPath: "./entry",
			targets: [
				{
					name: "default",
					applyToProducts: ["default"],
				},
			],
		},
	],
}
