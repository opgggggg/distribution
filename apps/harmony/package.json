{
	"name": "@cubexp/office-harmony",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "npm run build:web",
		"prebuild:web": "npm --prefix ../.. run profile:sync",
		"build:web": "vue-tsc -p tsconfig.json --noEmit && vite build --config vite.config.ts",
		"prebuild:web:android": "npm --prefix ../.. run profile:sync -- --android",
		"build:web:android": "vue-tsc -p tsconfig.json --noEmit && vite build --config vite.config.ts --mode android",
		"prebuild:web:ios": "npm --prefix ../.. run profile:sync -- --ios",
		"build:web:ios": "vue-tsc -p tsconfig.json --noEmit && vite build --config vite.config.ts --mode ios"
	},
	"dependencies": {
		"@cubexp/ofd": "*",
		"@cubexp/text": "*",
		"@yaochn/als-office-docx": "*",
		"@yaochn/als-office-editor-ui": "*",
		"@yaochn/als-office-image": "*",
		"@yaochn/als-office-markdown": "*",
		"@yaochn/als-office-pdf": "*",
		"@yaochn/als-office-pptx": "*",
		"@yaochn/als-office-vsdx": "*",
		"@yaochn/als-office-xlsx": "*",
		"vue": "3.5.32"
	},
	"devDependencies": {
		"@vitejs/plugin-vue": "^5.2.0",
		"typescript": "^5.0.3",
		"vite": "^6.4.3",
		"vue-tsc": "^3.3.8"
	}
}
