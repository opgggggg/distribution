// Identity comes from profiles/<profile>/app.json, the same source Gradle reads for
// Android. Regenerate with `npm run profile:sync -w @cubexp/office-ios`.
#include "Generated.xcconfig"

// Local signing settings, never committed. Copy Signing.xcconfig.sample to
// Signing.xcconfig and put your team id in it; without one Xcode simply asks which
// team to use the first time you build, which is the usual free-account flow.
#include? "Signing.xcconfig"

PRODUCT_NAME = AuroraPrimeOffice
INFOPLIST_FILE = App/Info.plist
GENERATE_INFOPLIST_FILE = NO
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME =

// iPhone and iPad from one binary, like the single HarmonyOS package.
TARGETED_DEVICE_FAMILY = 1,2
IPHONEOS_DEPLOYMENT_TARGET = 15.0

SWIFT_VERSION = 5.0
SWIFT_EMIT_LOC_STRINGS = NO
CLANG_ENABLE_MODULES = YES
ENABLE_USER_SCRIPT_SANDBOXING = NO
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM = $(AURORA_DEVELOPMENT_TEAM)
