[Unit]
Description=CubeOffice feedback and telemetry API
After=network.target postgresql.service

[Service]
Type=simple
User=cubeoffice-api
Group=cubeoffice-api
EnvironmentFile=/etc/cubeoffice-api.env
ExecStart=/usr/bin/python3 /opt/cubeoffice-api/server.py
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
