{
	"compilerOptions": {
		"baseUrl": ".",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"declaration": false,
		"noEmit": true,
		"noEmitOnError": true,
		"target": "ES2020",
		"lib": [
			"ESNext",
			"DOM"
		],
		"strict": true,
		"skipLibCheck": true
	},
	"include": [
		"src/**/*.ts"
	],
	"exclude": [
		"src/vue/**",
		"dist",
		"node_modules"
	]
}
