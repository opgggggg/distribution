{
	"name": "@cubexp/notes",
	"version": "0.1.0",
	"description": "CubeOffice paginated handwriting notebook and Vue editor",
	"license": "Apache-2.0",
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./brushes": {
			"types": "./dist/brushes.d.ts",
			"import": "./dist/brushes.js"
		},
		"./formats": {
			"types": "./dist/formats.d.ts",
			"import": "./dist/formats.js"
		},
		"./vue": {
			"types": "./dist/vue/editor.d.ts",
			"import": "./dist/vue/editor.js"
		},
		"./office": {
			"types": "./dist/office.d.ts",
			"import": "./dist/office.js"
		},
		"./office-vue": {
			"types": "./dist/office-vue.d.ts",
			"import": "./dist/office-vue.js"
		},
		"./thumbnail": {
			"types": "./dist/thumbnail.d.ts",
			"import": "./dist/thumbnail.js"
		},
		"./style.css": "./dist/style.css"
	},
	"scripts": {
		"build": "node ../../scripts/build-notes-kernel.mjs && tsc -p tsconfig.build.json && node -e \"const fs=require('node:fs');fs.copyFileSync('src/style.css','dist/style.css');fs.copyFileSync('src/kernel/notes-kernel.wasm','dist/kernel/notes-kernel.wasm')\"",
		"check:types": "tsc -p tsconfig.json",
		"test": "npm run build && cargo test --locked --manifest-path ../../Cargo.toml -p cubeoffice-notes-core && cargo build --locked --manifest-path ../../Cargo.toml -p cubeoffice-notes-core --bin cubeoffice-notes && node --test tests/*.mjs",
		"test:browser": "node tests/browser.cjs"
	},
	"dependencies": {
		"@xmldom/xmldom": "^0.9.12",
		"fflate": "^0.8.2",
		"pdf-lib": "^1.17.1",
		"perfect-freehand": "^1.2.2"
	},
	"peerDependencies": {
		"@yaochn/als-office-editor-core": ">=0.85.2 <1",
		"@yaochn/als-office-editor-ui": ">=0.85.2 <1",
		"vue": "^3.5.0"
	},
	"peerDependenciesMeta": {
		"@yaochn/als-office-editor-core": {
			"optional": true
		},
		"@yaochn/als-office-editor-ui": {
			"optional": true
		}
	},
	"devDependencies": {
		"typescript": "^5.0.3"
	}
}
